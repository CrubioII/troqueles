{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/api/*",
      "/static/*",
      "/media/*",
      "*.{png,jpg,jpeg,gif,svg,css,js,ico}"
    ]
  },
  "globalHeaders": {
    "content-security-policy": "default-src 'self' https: data: 'unsafe-inline' 'unsafe-eval';"
  },
  "routes": [
    {
      "route": "/version.json",
      "headers": {
        "cache-control": "no-store"
      }
    },
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-cache"
      }
    }
  ]
}
