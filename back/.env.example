SECRET_KEY=cambia-esto-en-produccion
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=app_password_aqui
DEFAULT_FROM_EMAIL=Troqueles INK <tu_correo@gmail.com>

# Recibe copia de cada remisión liquidada. Si se deja vacío se usa
# contabilidad@troquelesink.com (default en settings.py).
CONTADURIA_EMAIL=contabilidad@troquelesink.com

# --- Buzón de troqueles (app `correos`) ---
# En producción estos valores viven en las App Settings de Azure, no en un
# archivo. IMAP_PASSWORD es el único sin default utilizable en settings.py.
IMAP_HOST=mail.spacemail.com
IMAP_PORT=993
IMAP_USER=produccion@troquelesink.com
IMAP_PASSWORD=
IMAP_CARPETA_COTIZAR=Cotizar

# Bot que avisa cada troquel subido y cada alerta del procesamiento.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Ventana de búsqueda IMAP en días: deliberadamente amplia, la deduplicación
# real la hace la tabla CorreoProcesado.
BATCH_DIAS_ATRAS=3
# true = ensayo sin escribir nada (ni BD, ni archivos, ni flags, ni Telegram).
BATCH_DRY_RUN=false

# Listener IDLE (escuchar_correos): segundos de espera por ciclo, margen tras
# el aviso del servidor, y tope del backoff al reconectar.
IMAP_IDLE_TIMEOUT=840
IMAP_IDLE_GRACIA=5
LISTENER_BACKOFF_MAX=300
